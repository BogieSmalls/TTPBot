# Copy to /etc/ttpbot.env on the VM. Do not commit real values.
# Origin and slug must be set as a pair: racetime.gg uses z1r,
# raceroom.z1rracing.com uses z1rr. See docs/oci-service-runbook.md.
TTPBOT_RACETIME_ORIGIN=
TTPBOT_CATEGORY_SLUG=z1rr
TTPBOT_RACETIME_CLIENT_ID=
TTPBOT_RACETIME_CLIENT_SECRET=
TTPBOT_DISCORD_WEBHOOK_URL=
TTPBOT_RACE_SEEKERS_ROLE_ID=
TTPBOT_Z1RR_DISCORD_URL=
TTPBOT_Z1RR_RACEROOM_URL=https://raceroom.z1rracing.com/z1rr
TTPBOT_DATA_DIR=/var/lib/ttpbot
TTPBOT_ENVIRONMENT=production

# Z1RR League race automation (Phase 1). Set TTPBOT_LEAGUE_ENABLED=true to turn League scheduling on.
TTPBOT_LEAGUE_ENABLED=false
# Optional: override the published League schedule CSV.
TTPBOT_LEAGUE_SCHEDULE_URL=
# Discord webhook for #league-scheduling announcements.
TTPBOT_LEAGUE_DISCORD_WEBHOOK_URL=
# Bot token and channel for the weekly scheduling threads. A webhook cannot
# create threads, so this is the only part that needs the bot itself.
# The bot needs Create Public Threads in that channel.
TTPBOT_LEAGUE_DISCORD_BOT_TOKEN=
TTPBOT_LEAGUE_SCHEDULING_CHANNEL_ID=

# Record a finished League race on the results form, so nobody has to
# remember to fill it in afterwards. The bot posts the same form a racer
# would: one submission per pairing, so a co-op room files two.
TTPBOT_LEAGUE_RESULTS_ENABLED=false

# Grace minutes on scheduled TTP races. ENABLED tracks balances and says what
# it would do; ENFORCED is what actually force starts a race. SEASON wipes
# every balance back to the starting three when it changes.
TTPBOT_GRACE_ENABLED=false
TTPBOT_GRACE_ENFORCED=false
TTPBOT_GRACE_SEASON=TTP5

# Autumn Tournament: the engine owns the bracket, the sheet owns the schedule.
Z1RR_AUTUMN_ENABLED=false
Z1RR_ENGINE_URL=http://127.0.0.1:3007
Z1RR_ENGINE_TOKEN=
# Announce using the existing League bot token, in the Autumn channel.
TTPBOT_AUTUMN_DISCORD_CHANNEL_ID=1554172126880207009
# Optional separate credentials; the webhook takes precedence if configured.
TTPBOT_AUTUMN_DISCORD_BOT_TOKEN=
TTPBOT_AUTUMN_DISCORD_WEBHOOK_URL=

# Stable edition for the booth request key; do not change within a tournament.
Z1RR_AUTUMN_EDITION=2026
# The existing Z1RR_CONTROL_PLANE_URL / Z1RR_ROSTER_TOKEN and
# Z1RR_RELAY_URL / Z1RR_WAKE_TOKEN supply Autumn's optional booth adapter too.
