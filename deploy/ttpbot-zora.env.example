# Copy to /etc/ttpbot-zora.env on the VM. Do not commit real values.
# The zora category's own TTPBot: a second service from the same /opt/ttpbot,
# beside ttpbot.service. See "ZORA category" in docs/oci-service-runbook.md.
TTPBOT_RACETIME_ORIGIN=https://racetime.gg
TTPBOT_CATEGORY_SLUG=zora
# The zora category's own bot, from Manage bots on racetime.gg/zora. The z1r
# bot's credentials do not work here: a bot belongs to one category.
TTPBOT_RACETIME_CLIENT_ID=
TTPBOT_RACETIME_CLIENT_SECRET=
# The bot's name under Manage bots. TTPBot finds its own chat messages by it.
TTPBOT_RACETIME_BOT_NAME=Z1RRbot
# Never /var/lib/ttpbot: that is the z1r service's, and zora mode refuses it.
TTPBOT_DATA_DIR=/var/lib/ttpbot-zora
TTPBOT_ENVIRONMENT=production

# zora.gg's ZORA presets (from ZORA 2.0.1). Blank uses the built-in presets in
# ttpbot/config.py (ZORA_PRESETS) until a feed has loaded once; after that the
# cache's last good copy applies even with this blank. Delete the cache to go
# back to the built-ins (docs/oci-service-runbook.md, "ZORA category").
ZORA_PRESETS_URL=
ZORA_PRESETS_CACHE=/var/lib/ttpbot-zora/zora_presets.json

# Nothing else. Zora mode refuses to start with a z1r feature switched on
# (League, Autumn, Corto, the TTP tournament, grace minutes, nightly booths,
# a rehearsal, or a Discord webhook).
