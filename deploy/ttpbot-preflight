#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${TTPBOT_ENV_FILE:-/etc/ttpbot.env}"
if [[ -f "${ENV_FILE}" ]]; then
  set -a
  # shellcheck disable=SC1090
  . "${ENV_FILE}"
  set +a
fi

PYTHON_BIN="${TTPBOT_PYTHON_BIN:-/opt/ttpbot/.venv/bin/python}"
"${PYTHON_BIN}" -m ttpbot --check-config
exec "${PYTHON_BIN}" -m ttpbot --probe
